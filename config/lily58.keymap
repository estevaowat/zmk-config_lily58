#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // Combo keys are a way to combine multiple keypresses to output a different key.

    combos {
        compatible = "zmk,combos";

        combo_clear_bluetooth {
            timeout-ms = <50>; // Press all the below keys within 50ms to activate mapping
            key-positions = <52 42 0>; // Press 52=LOWER, 42=GUI+V, 0=tilde
            bindings = <&bt BT_CLR>; // activate clear bluetooth bindings for current channel
        };

        // Ported from crkbd: home-row combos for Enter / one-shot Ctrl / one-shot Alt

        combo_enter {
            timeout-ms = <50>; // Press J+K+L together for Enter
            key-positions = <31 32 33>; // 31=J, 32=K, 33=L
            bindings = <&kp RET>;
        };

        combo_one_shot_ctrl {
            timeout-ms = <50>; // Press S+D+F together for one-shot Ctrl
            key-positions = <26 27 28>; // 26=S, 27=D, 28=F
            bindings = <&sk LCTRL>;
        };

        combo_one_shot_alt {
            timeout-ms = <50>; // Press W+E+R together for one-shot Alt
            key-positions = <14 15 16>; // 14=W, 15=E, 16=R
            bindings = <&sk LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `      |  1     |  2     |  3      |  4      |  5   |                   |  6   |   7     |   8     |  9     |   0     |   -   |
            // |  GESC    |  Q     |  W     |  E      |  R      |  T   |                   |  Y   |   U     |   I     |  O     |   P     |   =   |
            // |  TAB     | A/LALT | S/LGUI | D/LCTRL | F/LSHFT |  G   |                   |  H   | J/RSHFT | K/RCTRL | L/LGUI | ;/RALT  |   '   |
            // | SHIFT    |  Z     |  X     |  C      |  V      |  B   | GUI+V  |  | GUI+Z |  N   |   M     |   ,     |  .     |   /     | SHIFT |
            //                        | ALT  | GUI  | LOWER| SPACE/RALT |  | BSPC  | ENTER/LCTRL | RAISE | CTRL  |
            // Home-row mods, GESC/TAB and thumb mod-taps ported from crkbd; combo & mo(1)/mo(2) layer switching unchanged.

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3     &kp N4  &kp N5                     &kp N6     &kp N7    &kp N8         &kp N9     &kp N0         &kp BACKSPACE
&gresc     &kp Q   &kp W     &kp E      &kp R   &kp T                      &kp Y      &kp U     &kp I          &kp O      &kp P          &kp EQUAL
&kp TAB    &kp A   &kp S     &kp D      &kp F   &kp G                      &kp H      &kp J     &kp K          &kp L      &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C      &kp V   &kp B           &kp LG(V)  &kp LG(Z)  &kp N     &kp M          &kp COMMA  &kp DOT        &kp FSLH       &kp RSHFT
                   &kp LALT  &kp LMETA  &mo 2   &mt RALT SPACE                        &kp BSPC  &mt LCTRL RET  &mo 1      &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  F12    |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |   F7  |   F8  |  F9  |  F10  |  F11  |
            // |   `     |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |   -   |
            // |CTRL/ESC |     |     |      |      |      |                   |  <-  |   ^   |   v   |  ->  |       |       |
            // | SHIFT   |     |     |      |      |      |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp F12        &kp F1  &kp F2             &kp F3                    &kp F4           &kp F5                            &kp F6    &kp F7       &kp F8     &kp F9     &kp F10   &kp F11
&kp GRAVE      &kp N1  &kp N2             &kp N3                    &kp N4           &kp N5                            &kp N6    &kp N7       &kp N8     &kp N9     &kp N0    &kp MINUS
&mt LCTRL ESC  &trans  &trans             &trans                    &trans           &trans                            &kp LEFT  &kp DOWN     &kp UP     &kp RIGHT  &trans    &trans
&kp LSHIFT     &trans  &trans             &trans                    &trans           &trans             &kp LG(SPACE)  &trans    &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp RIGHT_SHIFT
                       &kp LC(LG(SPACE))  &kp LS(LC(LG(NUMBER_4)))  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN                           &trans       &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |          | BT1     | BT2    |  BT3 |  BT4  |  BT5 |                    |      |       |       |      |       |       |
            // |          |         |        |      |       |      |                    |      |       |       |  [   |   ]   |   \   |
            // |   ~      |  !      |  @     |  #   |  $    |  %   |                    |  ^   |  &    |  *    |  (   |   )   |   _   |
            // | SHIFT    |  EP_ON  | EP_OFF |      |  (    |  {   |       |  |   DEL   |  }   |  )    |  +    |  {   |   }   | SHIFT |
            //                               |      |       |      |       |  |         |      |       |       |

            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &trans     &trans    &trans           &trans       &trans    &trans
&trans      &trans        &trans        &trans        &trans        &trans                &trans     &trans    &trans           &kp LBKT     &kp RBKT  &kp BSLH
&kp TILDE   &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT             &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR     &kp RPAR  &kp UNDER
&kp LSHIFT  &trans        &trans        &kp LPAR      &kp LBRC      &trans        &trans  &kp DEL    &kp RBRC  &kp RPAR         &kp KP_PLUS  &kp LBRC  &kp RBRC   &kp RSHIFT
                          &trans        &trans        &trans        &trans                           &trans    &trans           &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
